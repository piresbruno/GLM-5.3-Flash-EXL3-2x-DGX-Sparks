# One-shot Xid scan. Installed as a user unit by local/install-ops-units.sh,
# which substitutes @REPO_DIR@ with this checkout's absolute path.
[Unit]
Description=GLM-5.3 fleet Xid scan (R1 ops kit)

[Service]
Type=oneshot
ExecStart=@REPO_DIR@/local/xid-check.sh
# Xid lines live in the kernel ring buffer; user timers need journal access.
